---
import fs from 'node:fs';
import path from 'node:path';
import { ui, x, xHandle, linkedin, github, pathFor, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const otherLang: Lang = lang === 'en' ? 'es' : 'en';

// A badge renders only once its PNG has been dropped into public/badges/;
// until then the slot shows a reserved frame instead of a broken image.
const badgeExists = (badge?: string) =>
  !!badge && fs.existsSync(path.join(process.cwd(), 'public', badge));
---

<header class="site-header">
  <a class="brand" href={pathFor(lang)}>luciano<span class="brand-accent">@</span>arossa<span class="cursor" aria-hidden="true">_</span></a>
  <nav aria-label="Main">
    <a href={`#experience`}>{t.nav.experience}</a>
    <a href={`#projects`}>{t.nav.projects}</a>
    <a href={`#certifications`}>{t.nav.certifications}</a>
    <a href={`#about`}>{t.nav.about}</a>
    <a href={`#contact`}>{t.nav.contact}</a>
  </nav>
  <div class="lang-switch" role="group" aria-label="Language">
    <a href={pathFor('en')} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
    <span aria-hidden="true">/</span>
    <a href={pathFor('es')} aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
  </div>
</header>

<main>
  <section class="hero">
    <p class="hero-status">
      <span class="pulse" aria-hidden="true"></span>
      {t.hero.status} · {t.hero.location}
    </p>
    <h1>
      <span class="hero-greeting">{t.hero.greeting}</span>
      <span class="hero-role">{t.hero.role}</span>
    </h1>
    <div class="hero-actions">
      <a class="btn btn-primary" href={x} target="_blank" rel="noopener noreferrer">{t.hero.cta} ↗</a>
      <a class="btn" href={linkedin} target="_blank" rel="noopener noreferrer">{t.hero.ctaSecondary} ↗</a>
      <a class="btn" href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </section>

  <section id="experience" aria-labelledby="experience-title">
    <h2 id="experience-title"><span class="index" aria-hidden="true">01</span>{t.sections.experience}</h2>
    <ol class="jobs">
      {
        t.jobs.map((job) => (
          <li class="job">
            <div class="job-meta">
              <span class="job-period">{job.period}</span>
              {job.current && (
                <span class="job-current">
                  <span class="pulse" aria-hidden="true" />
                  {t.currentLabel}
                </span>
              )}
            </div>
            <div class="job-body">
              <h3>
                {job.role} <span class="job-company">· {job.company}</span>
              </h3>
              <p>{job.description}</p>
              <ul class="tags">
                {job.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="projects" aria-labelledby="projects-title">
    <h2 id="projects-title"><span class="index" aria-hidden="true">02</span>{t.sections.projects}</h2>
    {
      t.projects.map((project) => (
        <article class:list={['project', { 'project-featured': project.featured }]}>
          {project.featured && <span class="featured-badge">★ {t.featuredLabel}</span>}
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <div class="project-foot">
            <ul class="tags">
              {project.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
            <span class="project-links">
              {project.link && (
                <a class="code-link" href={project.link} target="_blank" rel="noopener noreferrer">
                  {t.visitLabel} ↗
                </a>
              )}
              {project.code && (
                <a class="code-link" href={project.code} target="_blank" rel="noopener noreferrer">
                  {t.codeLabel} ↗
                </a>
              )}
            </span>
          </div>
        </article>
      ))
    }
  </section>

  <section id="certifications" aria-labelledby="certifications-title">
    <h2 id="certifications-title"><span class="index" aria-hidden="true">03</span>{t.sections.certifications}</h2>
    <ul class="certs">
      {
        t.certs.map((cert) => (
          <li class="cert">
            <div class="cert-badge">
              {badgeExists(cert.badge) ? (
                <img src={cert.badge} alt={`${cert.name} badge`} width="96" height="96" loading="lazy" />
              ) : (
                <span class="cert-badge-slot" aria-hidden="true">
                  .png
                </span>
              )}
            </div>
            <div class="cert-body">
              <h3>
                {cert.name}
                {cert.issuer && <span class="cert-issuer"> · {cert.issuer}</span>}
              </h3>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="about" aria-labelledby="about-title">
    <h2 id="about-title"><span class="index" aria-hidden="true">04</span>{t.sections.about}</h2>
    <div class="about-grid">
      <div class="about-text">
        {t.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <aside class="focus" aria-label={t.focusTitle}>
        <h3>{t.focusTitle}</h3>
        <ul>
          {t.focus.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title"><span class="index" aria-hidden="true">05</span>{t.sections.contact}</h2>
    <p class="contact-lead">{t.contact.lead}</p>
    <p class="contact-email-label">{t.contact.handleLabel}</p>
    <a class="contact-email" href={x} target="_blank" rel="noopener noreferrer">{xHandle}</a>
  </section>
</main>

<footer class="site-footer">
  <span>© {new Date().getFullYear()} Luciano Arossa</span>
  <span>{t.footer}</span>
  <span class="footer-links">
    <a href={x} target="_blank" rel="noopener noreferrer">X</a>
    <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
  </span>
</footer>

<style>
  main {
    max-width: 62rem;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 4vw, 2.5rem);
  }

  /* ── Header ─────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0.9rem clamp(1.25rem, 4vw, 2.5rem);
    background: oklch(15.5% 0.014 255 / 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .brand-accent {
    color: var(--amber);
  }

  .cursor {
    color: var(--amber);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .site-header nav {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }

  .site-header nav a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.15s ease-out;
  }

  .site-header nav a:hover {
    color: var(--amber);
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    display: flex;
    gap: 0.4rem;
  }

  .lang-switch a {
    text-decoration: none;
    color: var(--ink-muted);
  }

  .lang-switch a[aria-current='true'] {
    color: var(--amber);
    font-weight: 700;
  }

  .lang-switch a:not([aria-current]):hover {
    color: var(--ink);
  }

  /* ── Hero ───────────────────────────────── */
  .hero {
    padding: clamp(5rem, 14vh, 9rem) 0 clamp(4rem, 10vh, 7rem);
  }

  .hero-status {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-muted);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
    animation: rise 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 0 oklch(79% 0.155 72 / 0.5);
    animation: ping 2.4s ease-out infinite;
    flex-shrink: 0;
  }

  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 oklch(79% 0.155 72 / 0.5);
    }
    70%,
    100% {
      box-shadow: 0 0 0 9px oklch(79% 0.155 72 / 0);
    }
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero-greeting {
    font-size: clamp(1.4rem, 3.5vw, 2.1rem);
    font-weight: 500;
    color: var(--ink-muted);
    animation: rise 0.6s 0.08s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-role {
    font-size: clamp(2.9rem, 9vw, 6.2rem);
    font-weight: 900;
    text-transform: uppercase;
    color: var(--ink);
    animation: rise 0.6s 0.16s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.75rem;
    animation: rise 0.6s 0.26s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .btn {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    padding: 0.8rem 1.4rem;
    border: 1px solid var(--line);
    color: var(--ink);
    transition:
      border-color 0.15s ease-out,
      background 0.15s ease-out,
      color 0.15s ease-out;
  }

  .btn:hover {
    border-color: var(--amber);
    color: var(--amber);
  }

  .btn-primary {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--bg);
  }

  .btn-primary:hover {
    background: var(--amber-deep);
    border-color: var(--amber-deep);
    color: var(--bg);
  }

  /* ── Sections ───────────────────────────── */
  section[id] {
    padding: clamp(3.5rem, 9vh, 6rem) 0;
    border-top: 1px solid var(--line);
  }

  h2 {
    font-size: clamp(1.9rem, 4.5vw, 2.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: clamp(2.25rem, 5vh, 3.5rem);
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .index {
    font-family: var(--font-mono);
    font-size: 0.55em;
    font-weight: 400;
    color: var(--amber);
  }

  /* ── Experience ─────────────────────────── */
  .jobs {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .job {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .job + .job {
    border-top: 1px dashed var(--line);
  }

  .job-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .job-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    padding-top: 0.35rem;
  }

  .job-current {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--amber);
    background: var(--amber-tint);
    padding: 0.3rem 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .job-current .pulse {
    width: 0.4rem;
    height: 0.4rem;
  }

  .job-body h3 {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.6rem;
  }

  .job-company {
    color: var(--amber);
    font-weight: 600;
  }

  .job-body p {
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    padding: 0.25rem 0.55rem;
  }

  /* ── Projects ───────────────────────────── */
  .project {
    background: var(--bg-raised);
    border: 1px solid var(--line);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .project + .project {
    margin-top: 1.5rem;
  }

  .project-featured {
    border-color: var(--amber-deep);
    background: oklch(20% 0.025 70);
  }

  .featured-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--bg);
    background: var(--amber);
    padding: 0.3rem 0.65rem;
    display: inline-block;
    margin-bottom: 1.1rem;
  }

  .project-links {
    display: flex;
    gap: 1.5rem;
  }

  .project h3 {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.8rem;
    max-width: 30ch;
  }

  .project p {
    color: var(--ink-muted);
    max-width: 68ch;
  }

  .project-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .project-foot .tags {
    margin-top: 0;
  }

  .code-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--amber);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease-out;
  }

  .code-link:hover {
    border-color: var(--amber);
  }

  /* ── Certifications ─────────────────────── */
  .certs {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .cert {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    align-items: center;
  }

  .cert + .cert {
    border-top: 1px dashed var(--line);
  }

  /* Uniform light plate: badge art is designed for light backgrounds,
     and it evens out transparent PNGs vs. opaque JPGs. */
  .cert-badge {
    width: 112px;
    height: 112px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem;
    background: oklch(96% 0.005 255);
    border: 1px solid var(--line);
  }

  .cert-badge img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .cert-badge-slot {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: oklch(45% 0.015 255);
  }

  .cert-body h3 {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .cert-issuer {
    color: var(--amber);
    font-weight: 600;
    font-size: 1.05rem;
  }

  /* ── About ──────────────────────────────── */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(14rem, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about-text p {
    max-width: 65ch;
    color: var(--ink-muted);
  }

  .about-text p:first-child {
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .about-text p + p {
    margin-top: 1.25rem;
  }

  .focus h3 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--amber);
    margin-bottom: 1rem;
  }

  .focus ul {
    list-style: none;
  }

  .focus li {
    padding: 0.55rem 0;
    font-size: 0.95rem;
    border-bottom: 1px dashed var(--line);
    counter-increment: focus;
    display: flex;
    gap: 0.75rem;
  }

  .focus li::before {
    content: counter(focus, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-muted);
    padding-top: 0.2rem;
  }

  /* ── Contact ────────────────────────────── */
  .contact-lead {
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    font-weight: 500;
    max-width: 34ch;
    margin-bottom: 2.5rem;
  }

  .contact-email-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  .contact-email {
    font-size: clamp(1.3rem, 4.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--amber);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease-out;
    word-break: break-all;
  }

  .contact-email:hover {
    border-color: var(--amber);
  }

  /* ── Footer ─────────────────────────────── */
  .site-footer {
    border-top: 1px solid var(--line);
    max-width: 62rem;
    margin: 0 auto;
    padding: 2rem clamp(1.25rem, 4vw, 2.5rem) 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  .site-footer a {
    color: var(--ink-muted);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--amber);
  }

  /* ── Responsive ─────────────────────────── */
  @media (max-width: 760px) {
    .site-header {
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
    }

    .site-header nav {
      order: 3;
      width: 100%;
      gap: 1.1rem;
      margin-left: 0;
    }

    .lang-switch {
      margin-left: auto;
    }

    .job {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .cert {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .job-meta {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    .job-period {
      padding-top: 0;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
